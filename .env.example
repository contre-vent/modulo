# Copy to .env. Never commit credentials.
OPENAI_API_KEY=
# Initial evaluation baseline; independently configurable from the Codex model.
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=low
# Slack CLI supplies these during `slack run`; otherwise set them manually.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEAM_ID=T0APQ2W08CX
SLACK_TIMEZONE_USER_ID=U0AQ242PF7F
# Optional override; otherwise use the installer account's Slack timezone.
REPORT_TIMEZONE=
DATABASE_PATH=./data/modulo.sqlite
PORT=3000
# Required for live annotations: HTTPS origin exposing only the educational server.
# Example: https://your-education-host.example
EDUCATION_BASE_URL=https://modulo.contre-vent.ca
# Start disabled until configuration and educational links are ready.
MODULO_ENABLED=false
